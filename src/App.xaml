<Application x:Class="Prisme.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
  <Application.Resources>

    <!-- ===== Palette ===== -->
    <Color x:Key="BgColor">#0A0A12</Color>
    <SolidColorBrush x:Key="Bg" Color="#0A0A12"/>
    <SolidColorBrush x:Key="Rail" Color="#0F0F1A"/>
    <SolidColorBrush x:Key="Card" Color="#151523"/>
    <SolidColorBrush x:Key="CardHover" Color="#1C1C2F"/>
    <SolidColorBrush x:Key="CardPress" Color="#232339"/>
    <SolidColorBrush x:Key="Stroke" Color="#24243A"/>
    <SolidColorBrush x:Key="StrokeHi" Color="#3A3A5C"/>
    <SolidColorBrush x:Key="Text" Color="#F4F3FF"/>
    <SolidColorBrush x:Key="Text2" Color="#A9A7C4"/>
    <SolidColorBrush x:Key="Text3" Color="#6E6C8A"/>
    <SolidColorBrush x:Key="Ok" Color="#3DDC97"/>
    <SolidColorBrush x:Key="Err" Color="#FF5C7A"/>
    <LinearGradientBrush x:Key="Spectrum" StartPoint="0,0" EndPoint="1,1">
      <GradientStop Color="#FF4D7E" Offset="0"/>
      <GradientStop Color="#B565FF" Offset="0.5"/>
      <GradientStop Color="#3DA5FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SpectrumH" StartPoint="0,0" EndPoint="1,0">
      <GradientStop Color="#FF4D7E" Offset="0"/>
      <GradientStop Color="#FF9A3D" Offset="0.25"/>
      <GradientStop Color="#B565FF" Offset="0.6"/>
      <GradientStop Color="#3DA5FF" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="SpectrumSoft" StartPoint="0,0" EndPoint="1,1" Opacity="0.16">
      <GradientStop Color="#FF4D7E" Offset="0"/>
      <GradientStop Color="#B565FF" Offset="0.5"/>
      <GradientStop Color="#3DA5FF" Offset="1"/>
    </LinearGradientBrush>

    <FontFamily x:Key="Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Body">Segoe UI Variable Text, Segoe UI</FontFamily>

    <!-- ===== Icônes vectorielles (trait, grille 24) ===== -->
    <Geometry x:Key="IcConvert">M4,8 H17 M13,4 L17,8 L13,12 M20,16 H7 M11,12 L7,16 L11,20</Geometry>
    <Geometry x:Key="IcDownload">M12,4 V15 M7,10 L12,15 L17,10 M5,20 H19</Geometry>
    <Geometry x:Key="IcSettings">M4,7 H13 M17,7 H20 M15,5 V9 M4,17 H7 M11,17 H20 M9,15 V19</Geometry>
    <Geometry x:Key="IcFolder">M3,7 A2,2 0 0 1 5,5 H9 L11,7 H19 A2,2 0 0 1 21,9 V17 A2,2 0 0 1 19,19 H5 A2,2 0 0 1 3,17 Z</Geometry>
    <Geometry x:Key="IcClose">M6,6 L18,18 M18,6 L6,18</Geometry>
    <Geometry x:Key="IcMin">M6,12 H18</Geometry>
    <Geometry x:Key="IcMax">M6,6 H18 V18 H6 Z</Geometry>
    <Geometry x:Key="IcRestore">M8,8 H17 V17 H8 Z M10,8 V6 H19 V15 H17</Geometry>
    <Geometry x:Key="IcUpload">M12,16 V5 M7,10 L12,5 L17,10 M5,19 H19</Geometry>
    <Geometry x:Key="IcPaste">M9,4 H15 V7 H9 Z M8,5.5 H6.5 A1,1 0 0 0 5.5,6.5 V19 A1,1 0 0 0 6.5,20 H17.5 A1,1 0 0 0 18.5,19 V6.5 A1,1 0 0 0 17.5,5.5 H16</Geometry>
    <Geometry x:Key="IcCheck">M5,12.5 L9.5,17 L19,7.5</Geometry>
    <Geometry x:Key="IcAlert">M12,4 L21,19 H3 Z M12,10 V14 M12,16.5 V16.6</Geometry>
    <Geometry x:Key="IcAudio">M9,17 V5 L20,3 V15 M9,17 A2.8,2.8 0 1 1 3.4,17 A2.8,2.8 0 1 1 9,17 Z M20,15 A2.8,2.8 0 1 1 14.4,15 A2.8,2.8 0 1 1 20,15 Z</Geometry>
    <Geometry x:Key="IcVideo">M3,6 H15 V18 H3 Z M15,10 L21,7 V17 L15,14</Geometry>
    <Geometry x:Key="IcImage">M3,5 H21 V19 H3 Z M3,16 L8.5,10.5 L13,15 L16,12 L21,17 M16.5,8.5 A1.5,1.5 0 1 1 13.5,8.5 A1.5,1.5 0 1 1 16.5,8.5 Z</Geometry>
    <Geometry x:Key="IcDoc">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,13 H16 M9,17 H16</Geometry>
    <Geometry x:Key="IcPdf">M6,3 H14 L19,8 V21 H6 Z M14,3 V8 H19 M9,14 H11 A1.5,1.5 0 0 0 11,11 H9 V17</Geometry>
    <Geometry x:Key="IcLink">M10,14 A4,4 0 0 0 15.7,14 L18.5,11.2 A4,4 0 0 0 12.8,5.5 L11.5,6.8 M14,10 A4,4 0 0 0 8.3,10 L5.5,12.8 A4,4 0 0 0 11.2,18.5 L12.5,17.2</Geometry>
    <Geometry x:Key="IcStop">M7,7 H17 V17 H7 Z</Geometry>
    <Geometry x:Key="IcTrash">M5,7 H19 M10,7 V4.5 H14 V7 M7,7 L8,20 H16 L17,7</Geometry>
    <Geometry x:Key="IcScissors">M9,6 A3,3 0 1 1 3,6 A3,3 0 1 1 9,6 Z M9,18 A3,3 0 1 1 3,18 A3,3 0 1 1 9,18 Z M8.4,7.8 L20,18.5 M8.4,16.2 L20,5.5</Geometry>
    <Geometry x:Key="IcEdit">M4,20 H8 L19,9 L15,5 L4,16 Z M13,7 L17,11</Geometry>
    <Geometry x:Key="IcPlay">M8,5 L19,12 L8,19 Z</Geometry>
    <Geometry x:Key="IcPause">M8,5 V19 M16,5 V19</Geometry>
    <Geometry x:Key="IcHeart">M12,20 C5,15 3,11.5 3,8.5 A4.5,4.5 0 0 1 12,6.5 A4.5,4.5 0 0 1 21,8.5 C21,11.5 19,15 12,20 Z</Geometry>

    <Style x:Key="Icon" TargetType="Path">
      <Setter Property="Width" Value="20"/>
      <Setter Property="Height" Value="20"/>
      <Setter Property="Stretch" Value="Uniform"/>
      <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Control}}"/>
      <Setter Property="StrokeThickness" Value="1.8"/>
      <Setter Property="StrokeStartLineCap" Value="Round"/>
      <Setter Property="StrokeEndLineCap" Value="Round"/>
      <Setter Property="StrokeLineJoin" Value="Round"/>
      <Setter Property="SnapsToDevicePixels" Value="False"/>
    </Style>

    <!-- ===== Textes ===== -->
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="FontFamily" Value="{StaticResource Display}"/>
      <Setter Property="FontSize" Value="30"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
    </Style>
    <Style x:Key="Sub" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style x:Key="Section" TargetType="TextBlock">
      <Setter Property="FontSize" Value="12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Foreground" Value="{StaticResource Text3}"/>
      <Setter Property="Margin" Value="2,0,0,10"/>
    </Style>

    <!-- ===== Boutons ===== -->
    <Style x:Key="BaseButton" TargetType="ButtonBase">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Padding" Value="16,9"/>
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ButtonBase">
            <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
                <Setter TargetName="b" Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardPress}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="b" Property="BorderBrush" Value="#B565FF"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Btn" TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Padding" Value="26,12"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Grid>
              <Border x:Name="glow" CornerRadius="12" Background="{StaticResource Spectrum}" Opacity="0">
                <Border.Effect><BlurEffect Radius="18"/></Border.Effect>
              </Border>
              <Border x:Name="b" CornerRadius="12" Background="{StaticResource Spectrum}" Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="b" Property="Opacity" Value="0.85"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="glow" Property="Opacity" Value="0.55"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.4"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- bouton icône rond, discret -->
    <Style x:Key="IconBtn" TargetType="Button" BasedOn="{StaticResource BaseButton}">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="BorderThickness" Value="0"/>
      <Setter Property="Padding" Value="7"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardPress}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- boutons de la barre de titre -->
    <Style x:Key="CaptionBtn" TargetType="Button">
      <Setter Property="Width" Value="46"/>
      <Setter Property="Height" Value="36"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#1FFFFFFF"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="CaptionClose" TargetType="Button" BasedOn="{StaticResource CaptionBtn}">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="Transparent">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="#E81123"/>
                <Setter Property="Foreground" Value="White"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- navigation latérale -->
    <Style x:Key="Nav" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontSize" Value="14.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,2"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="GroupName" Value="nav"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="bg" CornerRadius="10" Background="Transparent"/>
              <Border x:Name="bar" Width="3" Height="18" CornerRadius="2" HorizontalAlignment="Left"
                      Background="{StaticResource Spectrum}" Opacity="0"/>
              <ContentPresenter Margin="14,11" VerticalAlignment="Center"/>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource Card}"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource CardHover}"/>
                <Setter TargetName="bar" Property="Opacity" Value="1"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="bg" Property="Background" Value="{StaticResource CardHover}"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- choix segmenté (qualité de téléchargement, dossier de sortie) -->
    <Style x:Key="Chip" TargetType="RadioButton">
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="FontSize" Value="13.5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Margin" Value="0,0,8,8"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <Grid>
              <Border x:Name="ring" CornerRadius="10" Background="{StaticResource Spectrum}" Opacity="0"/>
              <Border x:Name="b" CornerRadius="9" Margin="1" Background="{StaticResource Card}" Padding="16,9">
                <ContentPresenter VerticalAlignment="Center"/>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="b" Property="Background" Value="{StaticResource CardHover}"/>
              </Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                <Setter TargetName="b" Property="Background" Value="#1A1730"/>
                <Setter Property="Foreground" Value="{StaticResource Text}"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="0.6"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- interrupteur -->
    <Style x:Key="Switch" TargetType="CheckBox">
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <Grid Width="44" Height="24" Background="Transparent">
              <Border x:Name="track" CornerRadius="12" Background="#2A2A42"/>
              <Border x:Name="on" CornerRadius="12" Background="{StaticResource Spectrum}" Opacity="0"/>
              <Ellipse x:Name="knob" Width="16" Height="16" Fill="#C9C7E0" HorizontalAlignment="Left" Margin="4,0">
                <Ellipse.RenderTransform><TranslateTransform x:Name="tx"/></Ellipse.RenderTransform>
              </Ellipse>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsChecked" Value="True">
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="20" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="tx" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.16">
                        <DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                      <DoubleAnimation Storyboard.TargetName="on" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16"/>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
                <Setter TargetName="knob" Property="Fill" Value="White"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="track" Property="Background" Value="#3A3A5C"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- champ texte -->
    <Style x:Key="Field" TargetType="TextBox">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="CaretBrush" Value="{StaticResource Text}"/>
      <Setter Property="SelectionBrush" Value="#B565FF"/>
      <Setter Property="FontSize" Value="15"/>
      <Setter Property="VerticalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="TextBox">
            <Grid>
              <Border x:Name="ring" CornerRadius="13" Background="{StaticResource Spectrum}" Opacity="0"/>
              <Border x:Name="b" CornerRadius="12" Margin="1" Background="{StaticResource Card}" BorderBrush="{StaticResource Stroke}" BorderThickness="1">
                <Grid Margin="16,0">
                  <TextBlock x:Name="ph" Text="{TemplateBinding Tag}" Foreground="{StaticResource Text3}" VerticalAlignment="Center"
                             IsHitTestVisible="False" Visibility="Collapsed" FontSize="{TemplateBinding FontSize}"/>
                  <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center"/>
                </Grid>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="Text" Value="">
                <Setter TargetName="ph" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsKeyboardFocused" Value="True">
                <Setter TargetName="ring" Property="Opacity" Value="1"/>
                <Setter TargetName="b" Property="BorderBrush" Value="Transparent"/>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- barre de progression fine en dégradé -->
    <Style x:Key="Bar" TargetType="ProgressBar">
      <Setter Property="Height" Value="4"/>
      <Setter Property="Maximum" Value="100"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ProgressBar">
            <Grid x:Name="TemplateRoot" ClipToBounds="True">
              <Border CornerRadius="2" Background="#24243A"/>
              <Border x:Name="PART_Track"/>
              <Border x:Name="PART_Indicator" CornerRadius="2" Background="{StaticResource SpectrumH}" HorizontalAlignment="Left"/>
              <Border x:Name="Animation" CornerRadius="2" Background="{StaticResource SpectrumH}" Width="90" HorizontalAlignment="Left" Visibility="Collapsed">
                <Border.RenderTransform><TranslateTransform x:Name="slide" X="-90"/></Border.RenderTransform>
              </Border>
            </Grid>
            <ControlTemplate.Triggers>
              <Trigger Property="IsIndeterminate" Value="True">
                <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed"/>
                <Setter TargetName="Animation" Property="Visibility" Value="Visible"/>
                <Trigger.EnterActions>
                  <BeginStoryboard x:Name="loop">
                    <Storyboard RepeatBehavior="Forever">
                      <DoubleAnimation Storyboard.TargetName="slide" Storyboard.TargetProperty="X" From="-90" To="700" Duration="0:0:1.4">
                        <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
                      </DoubleAnimation>
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions><StopStoryboard BeginStoryboardName="loop"/></Trigger.ExitActions>
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- barres de défilement fines -->
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="8"/>
      <Setter Property="MinWidth" Value="8"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb>
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Border x:Name="t" CornerRadius="4" Background="#2E2E48" Margin="2,0"/>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="t" Property="Background" Value="#4A4A6E"/>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <Style TargetType="ToolTip">
      <Setter Property="Foreground" Value="{StaticResource Text}"/>
      <Setter Property="Background" Value="#1C1C2F"/>
      <Setter Property="BorderBrush" Value="{StaticResource StrokeHi}"/>
      <Setter Property="Padding" Value="10,6"/>
      <Setter Property="FontSize" Value="12.5"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ToolTip">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
                    CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>

    <!-- chargement : anneau en dégradé qui tourne, avec halo (44 px ; mettre dans un Viewbox pour changer la taille) -->
    <ControlTemplate x:Key="Spinner" TargetType="Control">
      <Grid Width="44" Height="44">
        <Path Stroke="#24243A" StrokeThickness="3.5">
          <Path.Data><EllipseGeometry Center="22,22" RadiusX="19" RadiusY="19"/></Path.Data>
        </Path>
        <Grid RenderTransformOrigin="0.5,0.5">
          <Grid.RenderTransform><RotateTransform/></Grid.RenderTransform>
          <Grid.Triggers>
            <EventTrigger RoutedEvent="FrameworkElement.Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.9"/>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </Grid.Triggers>
          <Path Data="M22,3 A19,19 0 1 1 3,22" Stroke="{StaticResource Spectrum}" StrokeThickness="3.5"
                StrokeStartLineCap="Round" StrokeEndLineCap="Round">
            <Path.Effect><DropShadowEffect Color="#B565FF" BlurRadius="16" ShadowDepth="0" Opacity="0.8"/></Path.Effect>
          </Path>
        </Grid>
      </Grid>
    </ControlTemplate>

    <!-- texte qui respire sous l'anneau -->
    <Style x:Key="LoadingText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="{StaticResource Text2}"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="0,14,0,0"/>
      <Style.Triggers>
        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
          <BeginStoryboard>
            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
              <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0.45" Duration="0:0:0.9">
                <DoubleAnimation.EasingFunction><SineEase EasingMode="EaseInOut"/></DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="CardBox" TargetType="Border">
      <Setter Property="Background" Value="{StaticResource Card}"/>
      <Setter Property="BorderBrush" Value="{StaticResource Stroke}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="CornerRadius" Value="14"/>
      <Setter Property="Padding" Value="18,14"/>
    </Style>

  </Application.Resources>
</Application>
