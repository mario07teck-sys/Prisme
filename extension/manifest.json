{
  "manifest_version": 3,
  "name": "Prisme — télécharger les vidéos",
  "short_name": "Prisme",
  "version": "1.3.0",
  "description": "Clic droit sur une vidéo → « Télécharger avec Prisme ». La vidéo arrive dans le dossier de Prisme, sans pub.",
  "key": "",
  "permissions": ["contextMenus", "nativeMessaging", "activeTab"],
  "background": { "service_worker": "fond.js" },
  "action": {
    "default_title": "Télécharger avec Prisme",
    "default_popup": "fenetre.html",
    "default_icon": { "16": "icones/prisme-16.png", "32": "icones/prisme-32.png" }
  },
  "icons": { "16": "icones/prisme-16.png", "32": "icones/prisme-32.png", "48": "icones/prisme-48.png", "128": "icones/prisme-128.png" }
}
